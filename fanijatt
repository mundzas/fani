# Write files
for path_rel, content in files.items():
    full = os.path.join(root, path_rel)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "w", encoding="utf-8") as f:
        f.write(content)

# create uploads and db folders
os.makedirs(os.path.join(root, "public", "uploads"), exist_ok=True)
os.makedirs(os.path.join(root, "db"), exist_ok=True)
# create zip
zip_path = "/mnt/data/fanisite.zip"
if os.path.exists(zip_path):
    os.remove(zip_path)
with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for folder, _, files_in in os.walk(root):
        for fname in files_in:
            fpath = os.path.join(folder, fname)
            arcname = os.path.relpath(fpath, root)
            z.write(fpath, arcname)

print(json.dumps({"zip": zip_path, "message": "Created fanisite.zip with repository files. Download the zip from the link provided in the assistant response."}))
