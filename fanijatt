    "instagram_import.js": textwrap.dedent("""\
    require('dotenv').config();
    const fetch = require('node-fetch');
    const fs = require('fs');
    const path = require('path');
    const sqlite3 = require('sqlite3').verbose();
    const DBFILE = process.env.DATABASE_FILE || './db/database.sqlite';
    const UPLOAD_DIR = process.env.UPLOAD_DIR || './public/uploads';
    if(!fs.existsSync(UPLOAD_DIR)) fs.mkdirSync(UPLOAD_DIR, {recursive:true});

    const ACCESS_TOKEN = process.env.INSTAGRAM_ACCESS_TOKEN;
    const USER_ID = process.env.INSTAGRAM_USER_ID;

    if(!ACCESS_TOKEN || !USER_ID){
      console.error("Please set INSTAGRAM_ACCESS_TOKEN and INSTAGRAM_USER_ID in .env");
      process.exit(1);
    }

    const db = new sqlite3.Database(DBFILE);

    async function download(url, dest){
      const res = await fetch(url);
      if(!res.ok) throw new Error(Failed to fetch ${url});
      const fileStream = fs.createWriteStream(dest);
      await new Promise((resolve, reject)=>{
        res.body.pipe(fileStream);
        res.body.on('error', reject);
        fileStream.on('finish', resolve);
      });
    }

    (async ()=>{
      try{
        const fields = 'id,caption,media_type,media_url,timestamp';
        let url = https://graph.instagram.com/${USER_ID}/media?fields=${fields}&access_token=${ACCESS_TOKEN};
        while(url){
          const r = await fetch(url);
          const data = await r.json();
          if(data.error){ console.error("API error:", data.error); process.exit(1); }
          for(const item of data.data){
            console.log("Processing", item.id);
            const mediaUrl = item.media_url;
            const ext = require('path').extname(new URL(mediaUrl).pathname).split('?')[0] || '.jpg';
            const filename = ${item.id}${ext};
            const dest = path.join(UPLOAD_DIR, filename);
            if(!fs.existsSync(dest)){
              await download(mediaUrl, dest);
              console.log("Downloaded", filename);
            } else console.log("Already exists", filename);

            db.get("SELECT * FROM posts WHERE filename = ?", [filename], (err,row)=>{
              if(err) console.error(err);
              if(!row){
                db.run("INSERT INTO posts (user_id,title,filename,caption,media_type,created_at) VALUES (?,?,?,?,?,?)",
                  [1, item.id, filename, item.caption || '', item.media_type.toLowerCase(), item.timestamp], (e)=> {
                    if(e) console.error(e);
                    else console.log("Inserted post for", filename);
                  });
              }
            });
          }
          url = data.paging && data.paging.next ? data.paging.next : null;
        }
        console.log("Import finished.");
        db.close();
      }catch(e){ console.error(e); process.exit(1); }
    })();
